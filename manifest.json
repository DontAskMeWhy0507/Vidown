{
   "action": {
      "default_icon": "images/savior_logo.png",
      "default_title": "__MSG_page_action_title__",
      "default_popup": "popup/popup.html"
   },
   "background": {
      "service_worker": "background.chrome.js"
   },
   "content_scripts": [
      {
         "all_frames": true,
         "exclude_matches": [
            "file://*",
            "*://*.g.doubleclick.net/*",
            "*://*.challenges.cloudflare.com/*",
            "*://*.recaptcha.net/*",
            "*://*.google.com/recaptcha/*",
            "*://*.hcaptcha.com/*",
            "*://*.youtube.com/live_chat*"
         ],
         "js": [
            "context-guard.js",
            "common.js",
            "content-script.js",
            "downloads-nav.js"
         ],
         "matches": [
            "<all_urls>"
         ],
         "run_at": "document_idle"
      }
   ],
   "default_locale": "en",
   "description": "__MSG_appDescription__",
   "externally_connectable": {
      "matches": [
         "https://*.youtube.com/*"
      ]
   },
   "host_permissions": [
      "http://*/*",
      "https://*/*"
   ],
   "icons": {
      "48": "images/savior_logo.png",
      "128": "images/savior_logo.png"
   },
   "key": "MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDN4c7XRYXzpvahEEqCGsfZPXsl5kWXuv14AkytPEG4ok42OVda9wNV/GeZqYUO4IvW/3erMWGcnb+wyt2K9nds9aC+cKDf+eUU4vPAI8i/aWdPYe0G5tBlwitHJouftu9G5i6auE91IaXVbXkW5//zVHiB1v/MFunh4EkwfV9ONwIDAQAB",
   "manifest_version": 3,
   "minimum_chrome_version": "116",
   "name": "__MSG_appName__",
   "permissions": [
      "tabs",
      "webNavigation",
      "downloads",
      "downloads.open",
      "storage",
      "cookies",
      "scripting",
      "declarativeNetRequest",
      "declarativeNetRequestWithHostAccess",
      "webRequest",
      "alarms",
      "nativeMessaging"
   ],
   "version": "2.4.65",
   "web_accessible_resources": [
      {
         "matches": [
            "https://*/*",
            "http://*/*"
         ],
         "resources": [
            "css/*",
            "css/content-script.css",
            "images/*",
            "images/*.*"
         ]
      }
   ]
}
